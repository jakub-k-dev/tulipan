{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run optimize-images && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "optimize-images": "node scripts/optimize-images.mjs",
    "clean-unused-images": "node scripts/clean-unused-optimized-images.mjs",
    "clean-unused-images:dry": "node scripts/clean-unused-optimized-images.mjs --dry-run",
    "list-referenced-images": "node scripts/list-referenced-images.mjs",
    "list-referenced-images:gallery": "node scripts/list-referenced-images.mjs --gallery-only",
    "restore-referenced-images": "node scripts/restore-referenced-images-from-git.mjs",
    "restore-referenced-images:dry": "node scripts/restore-referenced-images-from-git.mjs --dry-run",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.17.1",
    "tailwindcss": "^3.4.17",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.58.0"
  }
}
