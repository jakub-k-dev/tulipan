---
import type { Locale } from '../data/translations';
import PageTextileHero from './PageTextileHero.astro';
import BigEventBody from './events/BigEventBody.astro';
import { tEvents } from '../data/translations';
import { getNextBigEvent } from '../data/bigEvents';

interface Props {
  locale: Locale;
  base: string;
}

const { locale } = Astro.props;
const t = tEvents(locale);
const next = getNextBigEvent();
---

<PageTextileHero title={t.title} />
<div class="bg-textile-cream">
  {next ? (
    <BigEventBody slug={next.slug} locale={locale} />
  ) : (
    <div class="max-w-[90rem] w-full mx-auto px-4 py-12">
      <p class="text-heritage-charcoal/80 text-base font-medium">{t.noEvents}</p>
    </div>
  )}
</div>
