---
import type { Locale } from '../data/translations';
import { galleryDisplaySrc } from '../data/gallery';
import type { GalleryImage } from '../data/gallery';
import GalleryLightbox from './GalleryLightbox.astro';

interface Props {
  images: GalleryImage[];
  locale: Locale;
  siteBase: string;
  /** When true, render only the photo buttons (no wrapper div, no lightbox). Parent must provide grid and lightbox. */
  itemsOnly?: boolean;
  /** When true with itemsOnly, parent is a grid: use col-span-2 for landscape (not column-span). */
  inGrid?: boolean;
  /** When true, no bottom margin on cards (for gapless masonry). */
  compact?: boolean;
}

const { images, locale, siteBase, itemsOnly = false, inGrid = false, compact = false } = Astro.props;

/** Scale factor for 90°/270° rotated images so they fill the card without gaps. */
const ROTATION_SCALE = 1.35;

function rotationStyle(rotate?: 90 | 180 | 270): string | undefined {
  if (!rotate) return undefined;
  const scale = rotate === 90 || rotate === 270 ? ROTATION_SCALE : 1;
  return `transform: rotate(${rotate}deg) scale(${scale})`;
}

function galleryCardClasses(img: GalleryImage, inGridLayout: boolean, noGap: boolean): string {
  const base = 'gallery-card block w-full overflow-hidden bg-heritage-charcoal/5 text-left cursor-pointer border-0 p-0' + (noGap ? ' rounded-none' : ' rounded-xl');
  const gap = inGridLayout ? '' : noGap ? ' break-inside-avoid' : ' break-inside-avoid mb-4';
  return base + gap;
}

function galleryImgClasses(): string {
  return 'w-full h-auto block pointer-events-none';
}
---

{/* Card: wide images span 2 columns (larger), tall images capped height (not huge). */}
{itemsOnly ? (
  images.map((img) => {
    const displaySrc = galleryDisplaySrc(img);
    const alt = locale === 'sk' ? img.altSk : img.altEn;
    const fullSrc = siteBase ? siteBase + img.src : img.src;
    return (
      <button
        type="button"
        class={galleryCardClasses(img, itemsOnly && inGrid, compact)}
        data-lightbox-src={fullSrc}
        data-lightbox-alt={alt}
        title={alt}
      >
        <img src={siteBase ? siteBase + displaySrc : displaySrc} alt={alt} width={img.width} height={img.height} class={galleryImgClasses()} style={rotationStyle(img.rotate)} loading="lazy" />
      </button>
    );
  })
) : (
  <>
    <div data-lightbox-container class="columns-1 sm:columns-2 lg:columns-4 [column-gap:1rem]">
      {images.map((img) => {
        const displaySrc = galleryDisplaySrc(img);
        const alt = locale === 'sk' ? img.altSk : img.altEn;
        const fullSrc = siteBase ? siteBase + img.src : img.src;
        return (
          <button
            type="button"
            class={galleryCardClasses(img, itemsOnly && inGrid, compact)}
            data-lightbox-src={fullSrc}
            data-lightbox-alt={alt}
            title={alt}
          >
            <img src={siteBase ? siteBase + displaySrc : displaySrc} alt={alt} width={img.width} height={img.height} class={galleryImgClasses()} style={rotationStyle(img.rotate)} loading="lazy" />
          </button>
        );
      })}
    </div>
    <GalleryLightbox siteBase={siteBase} />
  </>
)}
