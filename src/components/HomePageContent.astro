---
import type { Locale } from '../data/translations';
import OrnamentDivider from './OrnamentDivider.astro';
import RevealSection from './RevealSection.astro';
import UpcomingEventCard from './UpcomingEventCard.astro';
import { tHome, tSite } from '../data/translations';

interface Props {
  locale: Locale;
  siteBase: string;
  base: string;
}

const { locale, siteBase, base } = Astro.props;
const t = tHome(locale);
const siteT = tSite(locale);
---

<section class="relative min-h-[100vh] flex items-end justify-center overflow-hidden hero-carousel-section" aria-label={t.heroAria}>
  <div class="hero-carousel absolute inset-0 z-0" aria-hidden="true">
    {[1, 2, 3, 4].map((i) => (
      <picture class={`hero-carousel__slide ${i === 1 ? 'hero-carousel__slide--active' : ''}`} data-slide={i}>
        <source type="image/avif" srcset={`${siteBase}/images/hero/carousel-${i}.avif`} />
        <source type="image/webp" srcset={`${siteBase}/images/hero/carousel-${i}.webp`} />
        <img
          src={`${siteBase}/images/hero/carousel-${i}.jpg`}
          alt=""
          fetchpriority={i === 1 ? 'high' : undefined}
          loading={i === 1 ? 'eager' : 'lazy'}
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
      </picture>
    ))}
  </div>
  <div class="absolute inset-0 z-10 flex items-center justify-between px-2 sm:px-4 pointer-events-none">
    <button type="button" class="hero-carousel__btn hero-carousel__btn--prev pointer-events-auto w-12 h-12 sm:w-14 sm:h-14 rounded-full border-2 border-white/80 text-white/90 hover:bg-white/20 focus:outline focus:ring-2 focus:ring-white/60 flex items-center justify-center transition-all" aria-label={locale === 'sk' ? 'Predchádzajúci obrázok' : 'Previous image'}>
      <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button type="button" class="hero-carousel__btn hero-carousel__btn--next pointer-events-auto w-12 h-12 sm:w-14 sm:h-14 rounded-full border-2 border-white/80 text-white/90 hover:bg-white/20 focus:outline focus:ring-2 focus:ring-white/60 flex items-center justify-center transition-all" aria-label={locale === 'sk' ? 'Ďalší obrázok' : 'Next image'}>
      <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex gap-2 pointer-events-auto">
    {[1, 2, 3, 4].map((i) => (
      <button type="button" class="hero-carousel__dot w-2.5 h-2.5 rounded-full border-2 border-white/90 transition-all focus:outline focus:ring-2 focus:ring-white/60" data-slide={i} aria-label={locale === 'sk' ? `Obrázok ${i}` : `Image ${i}`} aria-current={i === 1 ? 'true' : undefined}></button>
    ))}
  </div>
  <div class="absolute inset-0 textile-overlay-dark z-10 pointer-events-none" aria-hidden="true" />
  <div class="relative z-20 w-full max-w-[90rem] mx-auto px-4 pb-20 pt-32 text-center md:text-left">
    <OrnamentDivider variant="bar" class="mb-6 justify-center md:justify-start" />
    <h1 class="font-display text-4xl md:text-5xl lg:text-6xl text-textile-outline font-semibold leading-tight max-w-2xl mx-auto md:mx-0 drop-shadow-lg">
      {t.title}
    </h1>
    <p class="mt-5 text-xl md:text-2xl text-textile-goldLight font-semibold max-w-xl mx-auto md:mx-0 drop-shadow-md">
      {t.subtitle}
    </p>
    <div class="mt-10 flex flex-wrap gap-4 justify-center md:justify-start">
      <a href={`${base}/about`} class="btn-red inline-block px-6 py-3 text-white font-semibold rounded-md transition-all border border-white/25">
        {t.ctaAbout}
      </a>
      <a href={`${base}/events`} class="inline-block px-6 py-3 border-2 border-textile-outline text-textile-outline font-semibold rounded-md hover:bg-textile-outline/10 transition-all">
        {t.ctaEvents}
      </a>
    </div>
  </div>
</section>

<div class="relative">
  <div class="textile-overlay">
    <div class="max-w-[90rem] w-full mx-auto px-4 py-16 md:py-24">

      <section class="mb-16 rounded-xl border-2 border-textile-gold/50 bg-heritage-charcoal/5 px-6 py-6 md:px-8 md:py-8 max-w-3xl" aria-label={locale === 'sk' ? 'Oznámenie' : 'Notice'}>
        <p class="text-heritage-charcoal leading-relaxed font-medium">{siteT.constructionMessage}</p>
      </section>

      <section id="next-event" class="scroll-mt-24 mb-16" aria-label={locale === 'sk' ? 'Najbližšie podujatie' : 'Next event'}>
        <RevealSection class="max-w-3xl">
          <UpcomingEventCard locale={locale} variant="teaser" base={base} />
        </RevealSection>
      </section>

      <RevealSection class="max-w-2xl">
        <p class="text-heritage-charcoal leading-relaxed text-lg font-medium">{t.intro}</p>
      </RevealSection>

      <section id="people-said" class="scroll-mt-24 mt-16">
        <RevealSection>
          <h2 class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">{t.peopleSaidTitle}</h2>
          <div class="mt-6 flex flex-col md:flex-row justify-center items-start gap-8">
            <iframe
              src="https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Fbratislavskykraj.sk%2Fposts%2Fpfbid02Mjv1UFrWn6QdQ9sKTxc6XTQagKkYP5gR7JxMBwQFdShfNaPG7Ljm6F81EpE2DcsKl&show_text=true&width=500"
              width="500"
              height="793"
              style="border:none;overflow:hidden;max-width:100%;"
              scrolling="no"
              frameborder="0"
              allowfullscreen="true"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              loading="lazy"
            ></iframe>
            <iframe
              src="https://www.facebook.com/plugins/post.php?href=https%3A%2F%2Fwww.facebook.com%2Fmichal.feik%2Fposts%2Fpfbid0NpHXqKLc8tDGwR39dRy6fLUTug5z4tpYSWSMX4r2aPyKn762eRmnndrauka6hB3Gl&show_text=true&width=500"
              width="500"
              height="812"
              style="border:none;overflow:hidden;max-width:100%;"
              scrolling="no"
              frameborder="0"
              allowfullscreen="true"
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
              loading="lazy"
            ></iframe>
          </div>
        </RevealSection>
      </section>

      <section id="sponsors" class="scroll-mt-24 mt-16 pt-12 border-t border-textile-gold/40" aria-labelledby="sponsors-heading">
        <RevealSection>
          <h2 id="sponsors-heading" class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">{t.sponsorsTitle}</h2>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-12 md:gap-16">
            <a href="https://www.fpu.sk/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center grayscale hover:grayscale-0 opacity-90 hover:opacity-100 transition-all" title="Fond na podporu umenia">
              <img src={`${siteBase}/images/sponsors/fpu.svg`} alt="Fond na podporu umenia" class="h-14 w-auto max-w-[220px] object-contain" width="233" height="69" loading="lazy" decoding="async" />
            </a>
            <a href="https://bratislavskykraj.sk/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center grayscale hover:grayscale-0 opacity-90 hover:opacity-100 transition-all" title="Bratislavský samosprávny kraj">
              <img src={`${siteBase}/images/sponsors/bsk.svg`} alt="Bratislavský samosprávny kraj" class="h-16 w-auto max-w-[160px] object-contain" width="160" height="90" loading="lazy" decoding="async" />
            </a>
            <a href="https://www.cataj.sk/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center grayscale hover:grayscale-0 opacity-90 hover:opacity-100 transition-all" title="Obec Čataj">
              <picture>
                <source type="image/webp" srcset={`${siteBase}/images/sponsors/cataj.webp`} />
                <img src={`${siteBase}/images/sponsors/cataj.png`} alt="Obec Čataj" class="h-16 w-auto max-w-[140px] object-contain" width="140" height="160" loading="lazy" decoding="async" />
              </picture>
            </a>
          </div>
        </RevealSection>
      </section>
    </div>
  </div>
</div>

<style is:global>
  .hero-carousel {
    isolation: isolate;
  }
  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
    pointer-events: none;
  }
  .hero-carousel__slide--active {
    opacity: 1;
    z-index: 1;
  }
  .hero-carousel__slide picture,
  .hero-carousel__slide img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-carousel__dot[aria-current="true"] {
    background-color: rgba(255, 255, 255, 0.9);
  }
</style>

<script>
  const TOTAL = 4;
  function initHeroCarousel() {
    const section = document.querySelector('.hero-carousel-section');
    if (!section) return;
    const slides = section.querySelectorAll('.hero-carousel__slide');
    const dots = section.querySelectorAll('.hero-carousel__dot');
    const prevBtn = section.querySelector('.hero-carousel__btn--prev');
    const nextBtn = section.querySelector('.hero-carousel__btn--next');

    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      current = (index + TOTAL) % TOTAL;
      slides.forEach((s, i) => s.classList.toggle('hero-carousel__slide--active', i === current));
      dots.forEach((d, i) => d.setAttribute('aria-current', i === current ? 'true' : 'false'));
      resetTimer();
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function resetTimer() {
      if (timer) clearInterval(timer);
      timer = setInterval(next, 5000);
    }

    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    resetTimer();
  }
  initHeroCarousel();
</script>
