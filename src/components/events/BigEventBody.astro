---
import type { Locale } from '../../data/translations';
import EventTulipan100 from './EventTulipan100.astro';

interface Props {
  slug: string;
  locale: Locale;
  nested?: boolean;
}

const { slug, locale, nested = false } = Astro.props;
---

{slug === '100-rokov-tulipan' && <EventTulipan100 locale={locale} nested={nested} />}
