---
import type { Locale } from '../../data/translations';
import OrnamentDivider from '../OrnamentDivider.astro';
import { getBigEventBySlug } from '../../data/bigEvents';
import { getYoutubeEmbedUrlFromFields } from '../../data/gallery';
import { siteBase } from '../../utils/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ev = getBigEventBySlug('100-rokov-tulipan')!;
const meta = ev[locale];

const videoEmbedUrl = getYoutubeEmbedUrlFromFields('https://www.youtube.com/watch?v=5Mq1KZaZczs');

type Sponsor = {
  slug: string;
  alt: string;
  /** Vector SVG — single file. Raster — AVIF + PNG fallback. */
  format: 'svg' | 'raster';
  /** Tailwind height class controls visible size. Wider logos use shorter heights. */
  size: 'tall' | 'wide';
  /** Optional sponsor website. Logo is rendered unlinked when omitted. */
  url?: string;
};

/** Sponsor logos in the order requested. Files live in `public/images/sponsors/`. */
const sponsors: Sponsor[] = [
  { slug: 'cataj',     alt: 'Obec Čataj',                    format: 'raster', size: 'tall', url: 'https://www.cataj.sk/' },
  { slug: 'bsk',       alt: 'Bratislavský samosprávny kraj', format: 'svg',    size: 'tall', url: 'https://bratislavskykraj.sk/' },
  { slug: 'fpu',       alt: 'Fond na podporu umenia',        format: 'svg',    size: 'wide', url: 'https://www.fpu.sk/' },
  { slug: 'mos',       alt: 'Malokarpatské osvetové stredisko',  format: 'raster', size: 'tall', url: 'https://www.moska.sk/' },
  { slug: 'elv',       alt: 'ELV Produkt',                   format: 'svg',    size: 'tall', url: 'https://elv.sk/' },
  { slug: 'pd-cataj',  alt: 'PD Čataj',                      format: 'raster', size: 'wide', url: 'https://www.pdcataj.sk/' },
  { slug: 'commander', alt: 'Commander',                     format: 'svg',    size: 'wide', url: 'https://commander.sk/' },
  { slug: 'ama',       alt: 'AMA Slovakia',                  format: 'svg',    size: 'wide', url: 'https://www.amaslovakia.sk/' },
  { slug: 'agromacaj', alt: 'Agromačaj',                     format: 'raster', size: 'wide' },
];

type ProgramItem = {
  time: string;
  heading: string;
  location?: string;
  lines: string[];
};

type Quote = { text: string; author: string; role: string };

type Content = {
  lede: string;
  freeEntry: string;
  videoHeading: string;
  videoTitle: string;
  invitationHeading: string;
  invitation: string[];
  aboutHeading: string;
  about: string[];
  quotes: Quote[];
  programHeading: string;
  moderatorLabel: string;
  moderator: string;
  program: ProgramItem[];
  joinChoirNote: string;
  patronageHeading: string;
  patronage: string;
  mainPartner: string;
  publicFunding: string;
};

const content: Record<Locale, Content> = {
  sk: {
    lede: 'Čataj oslávi 100 rokov folklóru — tradícia ožíva celodenným programom.',
    freeEntry: 'Vstup voľný',
    videoHeading: 'Videopozvánka',
    videoTitle: 'Videopozvánka — 100 rokov folklórnej skupiny Tulipán',
    invitationHeading: 'Pozvánka',
    invitation: [
      'Folklórna skupina Tulipán pozýva všetkých občanov na oslavy 100 rokov folklórnej skupiny v Čataji, ktoré sa budú konať v sobotu 16. mája 2026.',
      'Začiatok je o 11:00 v areáli dolnej školy (Družstevná 60). O 12:30 bude podujatie pokračovať krojovaným sprievodom spred budovy dolnej školy pred budovu obecného úradu po hlavnej ulici. Budeme radi, ak sa do sprievodu zapoja všetci občania, ktorí majú kroje, aby sa tým zvýšila atmosféra podujatia.',
      'Pred Kultúrnym domom sa bude konať bohatý sprievodný program — remeselné trhy s dielničkami, predaj ľudovoumeleckých výrobkov, vystúpenia hostí, detí materskej a základnej školy, rozhovory s bývalými aj súčasnými členmi folklórnej skupiny a iné. Pripravené je aj bohaté občerstvenie.',
      'O 18:00 sa uskutoční v sále kultúrneho domu slávnostný galaprogram. Po jeho skončení nasleduje ľudová veselica. Tešíme sa na vašu účasť.',
    ],
    aboutHeading: 'O podujatí',
    about: [
      'Obec Čataj si v sobotu 16. mája 2026 pripomenie 100 rokov od prvého zdokumentovaného folklórneho vystúpenia. Jubileum oslávi celodenným podujatím, ktoré prinesie krojovaný sprievod obcou, tradičné remeslá, folklórne vystúpenia aj slávnostný galaprogram s účasťou domácich a zahraničných súborov.',
      'Podujatie priblíži návštevníkom bohatstvo ľudovej kultúry prostredníctvom krojovaného sprievodu obcou, ukážok tradičných remesiel, workshopov a ochutnávok regionálnych jedál. Program vyvrcholí večerným galaprogramom v kultúrnom dome, kde vystúpi Folklórna skupina Tulipán Čataj spolu s domácimi aj hosťujúcimi súbormi vrátane zahraničných hostí z chorvátskeho mesta Ploče. Po galaprograme bude nasledovať ľudová veselica pre širokú verejnosť.',
      'Organizátori kladú dôraz nielen na samotné vystúpenia, ale aj na zážitok z tradičného života, ktorý si budú môcť návštevníci vyskúšať na vlastnej koži. Súčasťou programu budú remeselné dielne, prezentácie výroby krojov, drotárstva či zdobenia medovníkov, ako aj aktivity pre deti a rodiny.',
    ],
    quotes: [
      {
        text: 'Storočnica folklóru v Čataji je pre nás veľkou udalosťou, ale aj záväzkom. Je to príležitosť poďakovať sa generáciám ľudí, ktorí tradície udržiavali a odovzdávali ďalej. Zároveň chceme ukázať, že folklór má svoje miesto aj dnes a dokáže spájať ľudí naprieč generáciami.',
        author: 'Drahoslav Hauskrecht',
        role: 'predseda občianskeho združenia Folklórna skupina Tulipán Čataj',
      },
      {
        text: 'Pri príprave podujatia sme chceli vytvoriť priestor, kde sa prirodzene stretnú tradícia s dneškom. Nejde len o vystúpenia na pódiu, ale o celkovú atmosféru — stretnutia, rozhovory, spoločné zážitky. Veríme, že návštevníci si odnesú silný kultúrny aj osobný zážitok.',
        author: 'Hana Banová',
        role: 'projektová manažérka podujatia',
      },
    ],
    programHeading: 'Program podujatia',
    moderatorLabel: 'Moderátor',
    moderator: 'Erik Žibek',
    program: [
      {
        time: '11:00',
        heading: 'Slávnostné otvorenie',
        location: 'areál dolnej školy, Družstevná 60',
        lines: [
          'Vystúpenie detí ZUŠ',
          'Dychová hudba Šarfianka',
          'Ľudová hudba Farkašovci',
          'Spevácka skupina bývalých folkloristov',
          'Výstava dobových fotografií',
        ],
      },
      {
        time: '12:30',
        heading: 'Všetci do kroja',
        location: 'krojovaný sprievod od dolnej školy pred kultúrny dom',
        lines: [
          'Pozývame všetkých občanov s krojmi, aby sa pridali a spoločne vytvorili sprievod hlavnou ulicou.',
        ],
      },
      {
        time: '13:00',
        heading: 'Sprievodný program',
        location: 'pred Kultúrnym domom',
        lines: [
          'Vystúpenia hostí: FS Čífer, FS Slnečnica, FS z chorvátskeho Ploče, deti ZŠ s MŠ, FS Tulipán',
          'Remeselné trhy: výroba krojov, hrnčiarstvo, drotárstvo, zdobenie medovníkov, vyšívanie, pečenie praclíkov a iné',
          'Hry pre deti, drevený kolotoč, skákací hrad',
          'Degustácia vína, domáce špeciality a bohaté občerstvenie',
        ],
      },
      {
        time: '18:00',
        heading: 'Galaprogram',
        location: 'sála Kultúrneho domu',
        lines: [
          'Vystúpia: FS Tulipán Čataj, FS Mladosť Šenkvice, FS z chorvátskeho mesta Ploče, FS Technik',
        ],
      },
      {
        time: '21:00',
        heading: 'Ľudová veselica „Až do rána bieleho“',
        location: 'Kultúrny dom',
        lines: [
          'Do tanca hrá: Sirka Cuvée Ensemble a skupina Gin Tonic',
        ],
      },
    ],
    joinChoirNote:
      'Pozývame vás pripojiť sa k najväčšiemu folklórnemu zboru v Čataji piesňou „Nedaleko od Čataja“.',
    patronageHeading: 'Záštita a partneri',
    patronage:
      'Podujatie sa koná pod záštitou predsedu Bratislavského samosprávneho kraja Juraja Drobu.',
    mainPartner: 'Hlavný partner: obec Čataj.',
    publicFunding: 'Z verejných zdrojov podporil Fond na podporu umenia.',
  },
  en: {
    lede: 'Čataj celebrates 100 years of folklore — tradition comes alive in a full-day programme.',
    freeEntry: 'Free entry',
    videoHeading: 'Video invitation',
    videoTitle: 'Video invitation — 100 years of the Tulipán folklore group',
    invitationHeading: 'Invitation',
    invitation: [
      'The Tulipán folklore group invites all residents to the celebration of 100 years of the folklore group in Čataj, taking place on Saturday, 16 May 2026.',
      'The day starts at 11:00 in the grounds of the Lower School (Družstevná 60). At 12:30 the event continues with a costume procession from the Lower School past the village hall along the main street. We will be glad if all residents who own folk costumes join the procession to add to the atmosphere of the day.',
      'In front of the Cultural House (Kultúrny dom) a rich accompanying programme awaits — craft markets with workshops, sale of folk-art products, performances by guest ensembles, by children from the kindergarten and primary school, conversations with former and current members of the folklore group, and more. Plenty of refreshments will be available.',
      'At 18:00 a festive gala programme begins in the Cultural House hall. After it ends, a folk dance follows. We look forward to seeing you.',
    ],
    aboutHeading: 'About the event',
    about: [
      'On Saturday, 16 May 2026, the village of Čataj will mark 100 years since the first documented folklore performance. The anniversary will be celebrated with a full-day event featuring a costume procession through the village, traditional crafts, folklore performances, and a festive gala programme with local and international ensembles.',
      'The day brings the wealth of folk culture to visitors through a costume procession, demonstrations of traditional crafts, workshops, and tastings of regional dishes. The programme culminates in an evening gala in the Cultural House, where the Tulipán Čataj folklore group will perform together with local and guest ensembles, including international guests from the Croatian town of Ploče. After the gala, a folk dance for the wider public follows.',
      'The organisers place emphasis not only on performances themselves, but also on the experience of traditional life that visitors will be able to try first-hand. The programme includes craft workshops, demonstrations of folk-costume making, tinker craft and gingerbread decorating, as well as activities for children and families.',
    ],
    quotes: [
      {
        text: 'The centenary of folklore in Čataj is a great occasion for us, but also a commitment. It is an opportunity to thank the generations of people who kept the traditions alive and passed them on. At the same time, we want to show that folklore has its place today too, and that it can bring people together across generations.',
        author: 'Drahoslav Hauskrecht',
        role: 'chairman of the Tulipán Čataj Folklore Group civic association',
      },
      {
        text: 'In preparing the event we wanted to create a space where tradition and the present day meet naturally. It is not only about performances on stage — it is about the overall atmosphere: meetings, conversations, shared experiences. We believe visitors will take away a strong cultural and personal experience.',
        author: 'Hana Banová',
        role: 'project manager of the event',
      },
    ],
    programHeading: 'Programme',
    moderatorLabel: 'Host',
    moderator: 'Erik Žibek',
    program: [
      {
        time: '11:00',
        heading: 'Festive opening',
        location: 'grounds of the Lower School, Družstevná 60',
        lines: [
          'Performance by children of the local art school (ZUŠ)',
          'Brass band Šarfianka',
          'Folk band Farkašovci',
          'Singing group of former folk-group members',
          'Exhibition of historical photographs',
        ],
      },
      {
        time: '12:30',
        heading: 'Everyone in costume',
        location: 'costume procession from the Lower School to the Cultural House',
        lines: [
          'We invite all residents with folk costumes to join and create a procession along the main street together.',
        ],
      },
      {
        time: '13:00',
        heading: 'Accompanying programme',
        location: 'in front of the Cultural House',
        lines: [
          'Guest performances: FS Čífer, FS Slnečnica, FS from Ploče (Croatia), local kindergarten and primary-school children, FS Tulipán',
          'Craft markets: folk-costume making, pottery, tinker craft, gingerbread decorating, embroidery, pretzel baking, and more',
          'Games for children, wooden carousel, bouncy castle',
          'Wine tasting, homemade specialities and plentiful refreshments',
        ],
      },
      {
        time: '18:00',
        heading: 'Gala programme',
        location: 'Cultural House hall',
        lines: [
          'Performing: FS Tulipán Čataj, FS Mladosť Šenkvice, FS from Ploče (Croatia), FS Technik',
        ],
      },
      {
        time: '21:00',
        heading: 'Folk dance “Až do rána bieleho” (until the white dawn)',
        location: 'Cultural House',
        lines: [
          'Music for dancing: Sirka Cuvée Ensemble and Gin Tonic',
        ],
      },
    ],
    joinChoirNote:
      'Join the largest folklore choir in Čataj with the song “Nedaleko od Čataja”.',
    patronageHeading: 'Patronage and partners',
    patronage:
      'The event is held under the auspices of Juraj Droba, Chairman of the Bratislava Self-Governing Region.',
    mainPartner: 'Main partner: the village of Čataj.',
    publicFunding: 'Supported using public funds by the Slovak Arts Council (Fond na podporu umenia).',
  },
};

const c = content[locale];
---

<article class="bg-textile-cream">
  <div class="max-w-4xl w-full mx-auto px-4 py-12 md:py-16">
    <header class="text-center md:text-left">
      <h1 class="font-display text-3xl md:text-4xl lg:text-5xl text-heritage-charcoal font-semibold leading-tight">
        {meta.title}
      </h1>
      <p class="mt-3 text-heritage-charcoal/80 text-base md:text-lg italic max-w-3xl mx-auto md:mx-0">
        {c.lede}
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-heritage-charcoal/90 font-medium md:text-lg justify-center md:justify-start">
        <time datetime={ev.dateISO}>{meta.dateLabel}</time>
        <span aria-hidden="true">·</span>
        <span>{ev.place}</span>
        <span aria-hidden="true">·</span>
        <span class="inline-block px-2.5 py-0.5 rounded-full bg-groupRedDark text-white text-sm font-semibold">
          {c.freeEntry}
        </span>
      </p>
      <OrnamentDivider variant="bar" class="mt-6 justify-center md:justify-start" />
    </header>

    <section class="mt-10" aria-labelledby="invitation-heading">
      <h2 id="invitation-heading" class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">
        {c.invitationHeading}
      </h2>
      <div class="mt-4 space-y-4 text-heritage-charcoal/90 leading-relaxed">
        {c.invitation.map((p) => <p>{p}</p>)}
      </div>
    </section>

    {videoEmbedUrl && (
      <section class="mt-10" aria-labelledby="video-heading">
        <h2 id="video-heading" class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">
          {c.videoHeading}
        </h2>
        <div class="mt-4 aspect-video w-full rounded-xl overflow-hidden bg-heritage-charcoal/10 shadow-lg">
          <iframe
            src={videoEmbedUrl}
            title={c.videoTitle}
            class="w-full h-full"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      </section>
    )}

    <OrnamentDivider class="my-10" />

    <section aria-labelledby="about-heading">
      <h2 id="about-heading" class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">
        {c.aboutHeading}
      </h2>
      <div class="mt-4 space-y-4 text-heritage-charcoal/90 leading-relaxed">
        {c.about.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {c.quotes.map((q) => (
          <figure class="rounded-xl border-2 border-textile-gold/50 bg-white/90 p-5 md:p-6 shadow-sm">
            <blockquote class="text-heritage-charcoal/90 leading-relaxed italic">
              „{q.text}“
            </blockquote>
            <figcaption class="mt-4 text-sm">
              <span class="font-semibold text-heritage-charcoal">{q.author}</span>
              <span class="block text-heritage-charcoal/70">{q.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <OrnamentDivider class="my-10" />

    <section aria-labelledby="program-heading">
      <h2 id="program-heading" class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">
        {c.programHeading}
      </h2>
      <p class="mt-3 text-heritage-charcoal/80 text-sm">
        <span class="font-semibold">{c.moderatorLabel}:</span> {c.moderator}
      </p>
      <ol class="mt-6 space-y-6">
        {c.program.map((item) => (
          <li class="grid gap-2 md:grid-cols-[7rem_1fr] md:gap-6 border-l-2 border-textile-gold/60 pl-4 md:border-l-0 md:pl-0">
            <div class="font-display text-xl md:text-2xl text-groupRedDark font-semibold md:text-right md:pt-0.5">
              <time>{item.time}</time>
            </div>
            <div>
              <h3 class="font-display text-lg md:text-xl text-heritage-charcoal font-semibold">
                {item.heading}
              </h3>
              {item.location && (
                <p class="mt-1 text-heritage-charcoal/70 text-sm italic">{item.location}</p>
              )}
              <ul class="mt-2 space-y-1 text-heritage-charcoal/90 leading-relaxed">
                {item.lines.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-8 rounded-lg border border-textile-gold/50 bg-white/80 p-4 text-heritage-charcoal/90 italic">
        {c.joinChoirNote}
      </p>
    </section>

    <OrnamentDivider class="my-10" />

    <section aria-labelledby="patronage-heading">
      <h2 id="patronage-heading" class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">
        {c.patronageHeading}
      </h2>
      <div class="mt-4 space-y-2 text-heritage-charcoal/90 leading-relaxed">
        <p>{c.patronage}</p>
        <p>{c.mainPartner}</p>
        <p>{c.publicFunding}</p>
      </div>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Courgette&display=swap" />
      {[sponsors.slice(0, 4), sponsors.slice(4)].map((row) => (
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-8 sm:gap-x-10 md:gap-x-12 gap-y-8">
          {row.map((s) => {
            const heightClass = s.size === 'tall' ? 'h-16 md:h-20' : 'h-12 md:h-14';
            const blendStyle = (s.slug === 'ama' || s.slug === 'agromacaj') ? 'mix-blend-mode: multiply;' : '';
            const imgClass = `${heightClass} w-auto max-w-[140px] md:max-w-[160px] object-contain`;
            const inner = s.slug === 'pd-cataj' ? (
              <div class="flex flex-col items-center justify-center">
                <span
                  class="leading-none"
                  style="font-family: 'Courgette', cursive; font-weight: 400; color: #83C327; font-size: 1.625rem;"
                >
                  PD Čataj
                </span>
                <picture class="mt-0.5 flex items-center justify-center">
                  <source type="image/avif" srcset={`${siteBase}/images/sponsors/${s.slug}.avif`} />
                  <img
                    src={`${siteBase}/images/sponsors/${s.slug}.png`}
                    alt={s.alt}
                    class="h-8 md:h-10 w-auto max-w-[140px] object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </div>
            ) : s.format === 'svg' ? (
              <img
                src={`${siteBase}/images/sponsors/${s.slug}.svg`}
                alt={s.alt}
                class={imgClass}
                style={blendStyle}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <picture>
                <source type="image/avif" srcset={`${siteBase}/images/sponsors/${s.slug}.avif`} />
                <img
                  src={`${siteBase}/images/sponsors/${s.slug}.png`}
                  alt={s.alt}
                  class={imgClass}
                  style={blendStyle}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            );
            return (
              <li class="flex items-center justify-center">
                {s.url ? (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={s.alt}
                    class="flex items-center justify-center transition-opacity hover:opacity-80"
                  >
                    {inner}
                  </a>
                ) : inner}
              </li>
            );
          })}
        </ul>
      ))}
    </section>
  </div>
</article>
