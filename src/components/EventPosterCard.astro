---
import type { Locale } from '../data/translations';

interface Props {
  locale: Locale;
  siteBase?: string;
}

const { locale, siteBase = '' } = Astro.props;

// Standalone poster for the current event. Shown regardless of date (unlike the
// date-driven big-event cards). To swap in a new poster, replace the image files
// under public/images/events/ and update the fields below.
const poster = {
  base: `${siteBase}/images/events/vysivkarsky-kruzok-2026`,
  title: 'Výšivkársky krúžok',
  dateISO: '2026-10-06T19:00',
  sk: {
    eyebrow: 'Aktuálne podujatie',
    dateLabel: 'utorok 6. októbra 2026 · 19:00',
    place: 'Salónik KD Čataj',
    alt: 'Plagát: Výšivkársky krúžok FS Tulipán Čataj pod odborným vedením, každý utorok; prvé stretnutie 6. 10. o 19:00 v salóniku KD Čataj. Bližšie info: 0904 880 915, Eva Prôčková',
    view: 'Zobraziť plagát',
  },
  en: {
    eyebrow: 'Current event',
    dateLabel: 'Tuesday, 6 October 2026 · 19:00',
    place: 'Salónik, KD Čataj',
    alt: 'Poster: Embroidery circle by FS Tulipán Čataj, led by an expert, every Tuesday; first meeting 6 October at 19:00 in the salónik of KD Čataj. More info: 0904 880 915, Eva Prôčková',
    view: 'View poster',
  },
};

const t = poster[locale];
---

<article class="rounded-xl border-2 border-textile-gold/60 bg-white/95 shadow-lg overflow-hidden" aria-labelledby="event-poster-title">
  <div class="p-5 md:p-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-groupRedDark" aria-hidden="true">
      {t.eyebrow}
    </p>
    <h2 id="event-poster-title" class="font-display text-xl md:text-2xl text-heritage-charcoal font-semibold mt-1">
      {poster.title}
    </h2>
    <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-0 text-heritage-charcoal/90 font-medium">
      <time datetime={poster.dateISO}>{t.dateLabel}</time>
      <span aria-hidden="true">·</span>
      <span>{t.place}</span>
    </p>
    <a
      href={`${poster.base}.jpg`}
      target="_blank"
      rel="noopener noreferrer"
      class="group mt-4 block rounded-lg overflow-hidden border border-textile-gold/40 focus:outline focus:ring-2 focus:ring-groupRedDark/60"
      aria-label={t.view}
    >
      <picture>
        <source type="image/avif" srcset={`${poster.base}.avif`} />
        <img
          src={`${poster.base}.jpg`}
          alt={t.alt}
          width="1400"
          height="1980"
          loading="lazy"
          decoding="async"
          class="w-full h-auto max-w-[24rem] mx-auto transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </picture>
    </a>
    <a
      href={`${poster.base}.jpg`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-red mt-4 inline-block px-4 py-2 text-white font-semibold rounded-md transition-colors border border-white/20"
    >
      {t.view}
    </a>
  </div>
</article>
