---
interface Props {
  /** 'full' = wide band, 'bar' = short accent bar */
  variant?: 'full' | 'bar';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
const isBar = variant === 'bar';
---

{isBar ? (
  <div class={`flex items-center gap-1.5 ${className}`} aria-hidden="true">
    <span class="h-1 w-6 bg-textile-gold rounded-sm" />
    <span class="h-1 w-4 bg-groupRedDark rounded-sm" />
    <span class="h-1 w-6 bg-textile-gold rounded-sm" />
    <span class="h-1 w-3 bg-[#166534] rounded-sm" />
    <span class="h-1 w-2 bg-[#1d4ed8] rounded-sm" />
    <span class="h-1 w-4 bg-[#db2777] rounded-sm" />
  </div>
) : (
  <div class={`flex items-center gap-1 ${className}`} aria-hidden="true">
    <span class="h-0.5 flex-1 bg-textile-gold/40" />
    <span class="h-1 w-2 bg-groupRedDark rounded-full" />
    <span class="h-1 w-2 bg-textile-gold rounded-full" />
    <span class="h-1 w-2 bg-groupRedDark rounded-full" />
    <span class="h-0.5 flex-1 bg-textile-gold/40" />
  </div>
)}
