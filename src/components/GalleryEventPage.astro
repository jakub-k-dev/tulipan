---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { GalleryImage } from '../data/gallery';
import {
  getEventBySlug,
  getEventImages,
  formatGalleryDate,
  getYoutubeEmbedId,
  getYoutubeEmbedUrl,
  getYoutubeEmbedUrlFromFields,
  galleryDisplaySrc,
} from '../data/gallery';
import type { Locale } from '../data/translations';
import { tGallery } from '../data/translations';
import { siteBase } from '../utils/site';
import GalleryGrid from './GalleryGrid.astro';
import GalleryLightbox from './GalleryLightbox.astro';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = tGallery(locale);
const event = getEventBySlug(slug);
const galleryBase = locale === 'en' ? `${siteBase}/en/gallery` : `${siteBase}/gallery`;
const galleryPath = galleryBase || '/gallery';
const videoId = event ? getYoutubeEmbedId(event.videoUrl ?? '') : null;
const videoEmbedUrl = event ? getYoutubeEmbedUrl(event) : null;
const videoId2 = event ? getYoutubeEmbedId(event.videoUrl2 ?? '') : null;
const videoEmbedUrl2 =
  event?.videoUrl2
    ? getYoutubeEmbedUrlFromFields(
        event.videoUrl2,
        event.video2StartSeconds,
        event.video2EndSeconds,
      )
    : null;
const place =
  (event?.place?.trim() ||
    (locale === 'sk' ? event?.placeSk : event?.placeEn) ||
    '').trim() || '';
const description = locale === 'sk' ? event?.descriptionSk : event?.descriptionEn;
const eventLinks = event?.links?.length ? event.links : null;
const allImages = event ? getEventImages(event) : [];
const firstImage = allImages.length > 0 ? allImages[0] : null;
const secondImage = allImages.length > 1 ? allImages[1] : null;

type HeroCell =
  | { kind: 'video'; embedUrl: string }
  | { kind: 'image'; img: GalleryImage };

const dualVideo = !!(videoId && videoId2 && videoEmbedUrl && videoEmbedUrl2);
const singleVideo = !!(videoId && !videoId2 && videoEmbedUrl);
const videoRight = event?.heroVideoColumn === 'right';

let heroCol1: HeroCell | null = null;
let heroCol2: HeroCell | null = null;
let restOffset = 0;

if (dualVideo) {
  heroCol1 = { kind: 'video', embedUrl: videoEmbedUrl! };
  heroCol2 = { kind: 'video', embedUrl: videoEmbedUrl2! };
  restOffset = 0;
} else if (singleVideo && firstImage) {
  if (videoRight) {
    heroCol1 = { kind: 'image', img: firstImage };
    heroCol2 = { kind: 'video', embedUrl: videoEmbedUrl! };
  } else {
    heroCol1 = { kind: 'video', embedUrl: videoEmbedUrl! };
    heroCol2 = { kind: 'image', img: firstImage };
  }
  restOffset = 1;
} else if (singleVideo) {
  heroCol1 = { kind: 'video', embedUrl: videoEmbedUrl! };
  restOffset = 0;
} else if (firstImage && secondImage) {
  heroCol1 = { kind: 'image', img: firstImage };
  heroCol2 = { kind: 'image', img: secondImage };
  restOffset = 2;
} else if (firstImage) {
  heroCol1 = { kind: 'image', img: firstImage };
  restOffset = 1;
}

function flexAr(cell: HeroCell | null): number {
  if (!cell) return 1;
  if (cell.kind === 'video') return 16 / 9;
  return cell.img.width / cell.img.height;
}

const CARD_AR = 0.75;
const col1AR = flexAr(heroCol1);
const col2AR = flexAr(heroCol2);

const restImagesDesktop = allImages.slice(restOffset);
const showHeroRow = !!(heroCol1 || heroCol2);
---

{event ? (
  <BaseLayout title={`${locale === 'sk' ? event.titleSk : event.titleEn} — ${t.title}`} description={event.date !== '2000-01-01' ? formatGalleryDate(event.date, locale) : t.title} locale={locale} current="gallery">
    <div class="z-10 bg-textile-cream page-content-fill">
      <div class="w-full mx-auto px-4 md:px-6 lg:px-8 py-8">
        <a href={galleryPath} class="inline-flex items-center text-embroidery-crimson font-medium hover:underline mb-6 focus:outline-none focus:ring-2 focus:ring-embroidery-crimson rounded">
          {t.backToGallery}
        </a>
        <header class="mb-6">
          {event.date && event.slug !== 'ostatne' && (
            <time class="text-sm text-heritage-charcoal/70 font-medium" datetime={event.date}>
              {formatGalleryDate(event.date, locale)}
            </time>
          )}
          <h1 class="text-3xl font-display font-semibold text-heritage-charcoal mt-1">
            {locale === 'sk' ? event.titleSk : event.titleEn}
          </h1>
        </header>

        {event && (
          <div data-lightbox-container>
            {/* Mobile: event info first, then video, then all images */}
            <div class="columns-1 lg:hidden [column-gap:0.75rem] [column-fill:balance]">
              <div class="break-inside-avoid mb-4 rounded-xl border border-embroidery-ochre/40 bg-heritage-charcoal/[0.04] px-4 py-4" aria-label={t.eventDetailsLabel}>
                <p class="text-sm font-semibold uppercase tracking-wide text-heritage-charcoal/70 mb-3">{t.eventDetailsLabel}</p>
                <dl class="space-y-2 text-sm">
                  {event.date && event.slug !== 'ostatne' && (
                    <div>
                      <dt class="text-heritage-charcoal/60 font-medium">{t.eventDate}</dt>
                      <dd class="mt-0.5 text-heritage-charcoal">{formatGalleryDate(event.date, locale)}</dd>
                    </div>
                  )}
                  <div>
                    <dt class="text-heritage-charcoal/60 font-medium">{t.eventPlace}</dt>
                    <dd class="mt-0.5 text-heritage-charcoal">{place || '—'}</dd>
                  </div>
                  {description && (
                    <div>
                      <dt class="text-heritage-charcoal/60 font-medium">{t.eventDescription}</dt>
                      <dd class="mt-0.5 text-heritage-charcoal/90 leading-relaxed">{description}</dd>
                    </div>
                  )}
                  {eventLinks && (
                    <div>
                      <dt class="text-heritage-charcoal/60 font-medium">{t.eventLinks}</dt>
                      <dd class="mt-0.5 text-heritage-charcoal/90 space-y-1">
                        {eventLinks.map((link) => (
                          <div>
                            <a href={link.url} class="text-embroidery-crimson hover:underline break-all" target="_blank" rel="noopener noreferrer">
                              {(locale === 'sk' ? link.labelSk : link.labelEn)?.trim() || link.url}
                            </a>
                          </div>
                        ))}
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="text-heritage-charcoal/60 font-medium">{t.eventNotes}</dt>
                    <dd class="mt-0.5 text-heritage-charcoal/80">{t.eventPlaceholderNotes}</dd>
                  </div>
                </dl>
              </div>
              {dualVideo && videoEmbedUrl && videoEmbedUrl2 && (
                <>
                  <div class="break-inside-avoid mb-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-heritage-charcoal/60 mb-2">{t.videoLabel} 1</p>
                    <div class="aspect-video w-full rounded-xl overflow-hidden bg-heritage-charcoal/10 shadow-lg">
                      <iframe
                        src={videoEmbedUrl}
                        title={t.videoLabel}
                        class="w-full h-full"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                    </div>
                  </div>
                  <div class="break-inside-avoid mb-4">
                    <p class="text-xs font-semibold uppercase tracking-wide text-heritage-charcoal/60 mb-2">{t.videoLabel} 2</p>
                    <div class="aspect-video w-full rounded-xl overflow-hidden bg-heritage-charcoal/10 shadow-lg">
                      <iframe
                        src={videoEmbedUrl2}
                        title={t.videoLabel}
                        class="w-full h-full"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                      />
                    </div>
                  </div>
                </>
              )}
              {singleVideo && videoRight && firstImage && (
                <div class="break-inside-avoid mb-4">
                  <button type="button" class="gallery-card block w-full overflow-hidden bg-heritage-charcoal/5 text-left cursor-pointer border-0 p-0 rounded-xl" data-lightbox-src={siteBase ? siteBase + firstImage.src : firstImage.src} data-lightbox-alt={locale === 'sk' ? firstImage.altSk : firstImage.altEn} title={locale === 'sk' ? firstImage.altSk : firstImage.altEn}>
                    <img src={siteBase ? siteBase + galleryDisplaySrc(firstImage) : galleryDisplaySrc(firstImage)} alt={locale === 'sk' ? firstImage.altSk : firstImage.altEn} width={firstImage.width} height={firstImage.height} class="w-full h-auto block pointer-events-none" loading="lazy" />
                  </button>
                </div>
              )}
              {singleVideo && videoEmbedUrl && !(dualVideo) && (
                <div class="break-inside-avoid mb-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-heritage-charcoal/60 mb-2">{t.videoLabel}</p>
                  <div class="aspect-video w-full rounded-xl overflow-hidden bg-heritage-charcoal/10 shadow-lg">
                    <iframe
                      src={videoEmbedUrl}
                      title={t.videoLabel}
                      class="w-full h-full"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                </div>
              )}
              {allImages.length > 0 && <GalleryGrid images={allImages} locale={locale} siteBase={siteBase} itemsOnly />}
            </div>
            {/* Desktop: justified first row — widths proportional to aspect ratios so all cells are the same height */}
            <div class="hidden lg:block">
              {showHeroRow && (
              <div class="rounded-xl border-2 border-embroidery-ochre/50 bg-heritage-charcoal/[0.04] p-3 mb-6">
                <div class="flex gap-3">
                  {heroCol1 && (
                  <div style={`flex: ${col1AR} 1 0%`} class="min-w-0 overflow-hidden rounded-lg">
                    {heroCol1.kind === 'video' ? (
                      <div class="aspect-video w-full overflow-hidden bg-heritage-charcoal/10">
                        <iframe
                          src={heroCol1.embedUrl}
                          title={t.videoLabel}
                          class="w-full h-full"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                        />
                      </div>
                    ) : (
                      <button type="button" class="gallery-card block w-full overflow-hidden bg-heritage-charcoal/5 text-left cursor-pointer border-0 p-0 rounded-lg" data-lightbox-src={siteBase ? siteBase + heroCol1.img.src : heroCol1.img.src} data-lightbox-alt={locale === 'sk' ? heroCol1.img.altSk : heroCol1.img.altEn} title={locale === 'sk' ? heroCol1.img.altSk : heroCol1.img.altEn}>
                        <img src={siteBase ? siteBase + galleryDisplaySrc(heroCol1.img) : galleryDisplaySrc(heroCol1.img)} alt={locale === 'sk' ? heroCol1.img.altSk : heroCol1.img.altEn} width={heroCol1.img.width} height={heroCol1.img.height} class="w-full h-auto block pointer-events-none" loading="lazy" />
                      </button>
                    )}
                  </div>
                  )}
                  {heroCol2 && (
                  <div style={`flex: ${col2AR} 1 0%`} class="min-w-0 overflow-hidden rounded-lg">
                    {heroCol2.kind === 'video' ? (
                      <div class="aspect-video w-full overflow-hidden bg-heritage-charcoal/10">
                        <iframe
                          src={heroCol2.embedUrl}
                          title={t.videoLabel}
                          class="w-full h-full"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                          allowfullscreen
                        />
                      </div>
                    ) : (
                      <button type="button" class="gallery-card block w-full overflow-hidden bg-heritage-charcoal/5 text-left cursor-pointer border-0 p-0 rounded-lg" data-lightbox-src={siteBase ? siteBase + heroCol2.img.src : heroCol2.img.src} data-lightbox-alt={locale === 'sk' ? heroCol2.img.altSk : heroCol2.img.altEn} title={locale === 'sk' ? heroCol2.img.altSk : heroCol2.img.altEn}>
                        <img src={siteBase ? siteBase + galleryDisplaySrc(heroCol2.img) : galleryDisplaySrc(heroCol2.img)} alt={locale === 'sk' ? heroCol2.img.altSk : heroCol2.img.altEn} width={heroCol2.img.width} height={heroCol2.img.height} class="w-full h-auto block pointer-events-none" loading="lazy" />
                      </button>
                    )}
                  </div>
                  )}
                  <div style={`flex: ${CARD_AR} 1 0%`} class="min-w-[180px] flex flex-col justify-center rounded-lg border border-embroidery-ochre/40 bg-heritage-charcoal/[0.04] px-4 py-4" aria-label={t.eventDetailsLabel}>
                    <p class="text-sm font-semibold uppercase tracking-wide text-heritage-charcoal/70 mb-3">{t.eventDetailsLabel}</p>
                    <dl class="space-y-2 text-sm">
                      {event.date && event.slug !== 'ostatne' && (
                        <div>
                          <dt class="text-heritage-charcoal/60 font-medium">{t.eventDate}</dt>
                          <dd class="mt-0.5 text-heritage-charcoal">{formatGalleryDate(event.date, locale)}</dd>
                        </div>
                      )}
                      <div>
                        <dt class="text-heritage-charcoal/60 font-medium">{t.eventPlace}</dt>
                        <dd class="mt-0.5 text-heritage-charcoal">{place || '—'}</dd>
                      </div>
                      {description && (
                        <div>
                          <dt class="text-heritage-charcoal/60 font-medium">{t.eventDescription}</dt>
                          <dd class="mt-0.5 text-heritage-charcoal/90 leading-relaxed">{description}</dd>
                        </div>
                      )}
                      {eventLinks && (
                        <div>
                          <dt class="text-heritage-charcoal/60 font-medium">{t.eventLinks}</dt>
                          <dd class="mt-0.5 text-heritage-charcoal/90 space-y-1">
                            {eventLinks.map((link) => (
                              <div>
                                <a href={link.url} class="text-embroidery-crimson hover:underline break-all" target="_blank" rel="noopener noreferrer">
                                  {(locale === 'sk' ? link.labelSk : link.labelEn)?.trim() || link.url}
                                </a>
                              </div>
                            ))}
                          </dd>
                        </div>
                      )}
                      <div>
                        <dt class="text-heritage-charcoal/60 font-medium">{t.eventNotes}</dt>
                        <dd class="mt-0.5 text-heritage-charcoal/80">{t.eventPlaceholderNotes}</dd>
                      </div>
                    </dl>
                  </div>
                </div>
              </div>
              )}
              {restImagesDesktop.length > 0 && (
                <div class="columns-3 [column-gap:0.75rem] [column-fill:balance]">
                  <GalleryGrid images={restImagesDesktop} locale={locale} siteBase={siteBase} itemsOnly />
                </div>
              )}
            </div>
            <GalleryLightbox siteBase={siteBase} />
          </div>
        )}
      </div>
    </div>
  </BaseLayout>
) : (
  <BaseLayout title={t.title} locale={locale} current="gallery">
    <div class="z-10 bg-textile-cream page-content-fill px-4 py-12 text-center">
      <p class="text-heritage-charcoal/80">{locale === 'sk' ? 'Podujatie sa nenašlo.' : 'Event not found.'}</p>
      <a href={galleryPath} class="mt-4 inline-block text-embroidery-crimson font-medium hover:underline">{t.backToGallery}</a>
    </div>
  </BaseLayout>
)}
