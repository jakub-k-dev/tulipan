---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tNotFound } from '../data/translations';
import { siteBase } from '../utils/site';

// GitHub Pages serves this single 404.html for every missing URL (SK and EN),
// so the page shows both languages instead of guessing from the path.
const sk = tNotFound('sk');
const en = tNotFound('en');
---

<BaseLayout title={`${sk.title} · ${en.title}`} description={sk.message} locale="sk" current="" noindex>
  <div class="bg-textile-cream min-h-[60vh] flex flex-col items-center justify-center px-4 py-16">
    <div class="max-w-xl text-center">
      <h1 class="font-display text-3xl md:text-4xl text-heritage-charcoal font-semibold">{sk.heading}</h1>
      <p class="mt-4 text-heritage-charcoal/90 font-medium">{sk.message}</p>
      <div lang="en" class="mt-8">
        <p class="font-display text-2xl md:text-3xl text-heritage-charcoal font-semibold">{en.heading}</p>
        <p class="mt-4 text-heritage-charcoal/90 font-medium">{en.message}</p>
      </div>
      <!-- Placeholder for folk photo: owner will add a specific funny folk photo here -->
      <div class="mt-10 flex justify-center">
        <img
          src={`${siteBase || ''}/images/logo.svg`}
          alt=""
          class="w-32 h-32 opacity-60"
          width="128"
          height="128"
        />
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={siteBase ? `${siteBase}/` : '/'}
          class="inline-block px-6 py-3 bg-groupRedDark text-white font-semibold rounded-md hover:opacity-90 transition-opacity"
        >
          {sk.goHome}
        </a>
        <a
          href={`${siteBase}/en/`}
          lang="en"
          class="inline-block px-6 py-3 bg-groupRedDark text-white font-semibold rounded-md hover:opacity-90 transition-opacity"
        >
          {en.goHome}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
