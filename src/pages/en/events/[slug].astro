---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BigEventBody from '../../../components/events/BigEventBody.astro';
import { bigEvents, getBigEventBySlug, getBigEventJsonLd } from '../../../data/bigEvents';
import { siteBase } from '../../../utils/site';

export function getStaticPaths() {
  return bigEvents.map((e) => ({ params: { slug: e.slug } }));
}

const locale = 'en';
const { slug } = Astro.params;
const ev = getBigEventBySlug(slug!)!;
const meta = ev.en;

const siteOrigin = Astro.site ? Astro.site.href.replace(/\/$/, '') : Astro.url.origin;
const canonicalHref = new URL(Astro.url.pathname, siteOrigin).href;
const imageUrl = new URL(`${siteBase || ''}/images/hero/carousel-1.jpg`, siteOrigin).href;
const orgUrl = new URL(siteBase || '/', siteOrigin).href;
const eventJsonLdObj = getBigEventJsonLd(slug!, locale, { canonicalHref, imageUrl, orgUrl });
const eventJsonLd = eventJsonLdObj ? JSON.stringify(eventJsonLdObj) : null;
---

<BaseLayout title={meta.title} description={meta.shortDescription} locale={locale} current="events">
  {eventJsonLd && <script type="application/ld+json" is:inline slot="head" set:html={eventJsonLd} />}
  <BigEventBody slug={slug!} locale={locale} />
</BaseLayout>
