---
import GalleryEventPage from '../../../components/GalleryEventPage.astro';
import { galleryEventsForDisplay, galleryVisible } from '../../../data/gallery';

export function getStaticPaths() {
  if (!galleryVisible) return [];
  return galleryEventsForDisplay.map((event) => ({ params: { slug: event.slug } }));
}

const { slug } = Astro.params;
---

<GalleryEventPage locale="sk" slug={slug!} />
